# Safe default: never change this to REAL without completing the README checklist.
FUTU_TRD_ENV=SIMULATE
FUTU_DEFAULT_MARKET=US
FUTU_ACC_ID=
EXPECTED_REAL_ACCOUNT_ID=
ENABLE_LIVE_TRADING=false
FUTU_SECURITY_FIRM=
TRADING_STATE_DB=data/trading.db

# Conservative execution limits
MAX_ACCOUNT_UTILIZATION=0.25
MAX_MARGIN_UTILIZATION=0.50
MAX_GROSS_EXPOSURE=50000
MAX_PAIR_EXPOSURE=10000
MAX_OPEN_PAIRS=5
MAX_PENDING_OPERATIONS=5
ESTIMATED_MARGIN_RATE=1.0
DATA_MAX_AGE_SECONDS=900
REQUIRE_MARKET_STATE=true
REQUIRE_SYMBOL_VALIDATION=true
